<resources>
    <!-- Only the window behind Compose; every screen draws its own background. -->
    <style name="Theme.EOBApp" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_light</item>
    </style>

    <style name="Theme.EOBApp.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.EOBApp</item>
    </style>
</resources>
